{
  "name": "hoshi",
  "private": true,
  "scripts": {
    "dev": "cargo run -p hoshi-native",
    "build": "cargo build --release -p hoshi-native",
    "check": "biome check . && cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings",
    "fix": "biome check --write . && cargo fmt --all",
    "test": "cargo test --workspace --no-fail-fast && bun test ./scripts",
    "bump": "bun scripts/bump.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.6.6",
    "@tauri-apps/cli": "2.12.4"
  }
}
