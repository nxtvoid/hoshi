{
  "name": "hoshi",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "catalog": {
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "dev": "bun run --cwd apps/desktop tauri dev",
    "build": "bun run --cwd apps/desktop tauri build",
    "typecheck": "bun run --filter './apps/*' --filter './packages/*' typecheck",
    "check": "biome check . && cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings",
    "fix": "biome check --write . && cargo fmt --all",
    "test": "cargo test --workspace && bun run --filter './apps/*' --filter './packages/*' test",
    "bindings": "cargo test -p hoshi-core export_bindings",
    "bump": "bun scripts/bump.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "~2.6.6"
  }
}
