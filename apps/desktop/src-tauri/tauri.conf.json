{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "hoshi",
  "version": "../package.json",
  "identifier": "dev.hoshi.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "hoshi",
        "width": 1280,
        "height": 820,
        "minWidth": 800,
        "minHeight": 500,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk0M0Y1MUUwQzM1MUYyQkIKUldTNzhsSEQ0RkUvbEVPOVpFc2xtaXVWNExFS3pqMmRuR0xFbjhoa3k3RUVlTGVhRHdzMjRibEYK",
      "endpoints": [
        "https://github.com/nxtvoid/hoshi/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
