{
  "name": "@hoshi/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun run i18n && tsc --noEmit && vite build",
    "typecheck": "bun run i18n && tsc --noEmit",
    "i18n": "paraglide-js compile --project ./project.inlang",
    "check:i18n": "inlang check --project ./project.inlang",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "3.2.1",
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2",
    "@types/node": "^24",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "@inlang/cli": "^3.4.0"
  }
}
