---
import type { HTMLAttributes } from 'astro/types'

type Props = HTMLAttributes<'a'> & {
  variant?: 'primary' | 'outline'
  size?: 'sm' | 'md'
}

const {
  variant = 'outline',
  size = 'md',
  class: className,
  ...rest
} = Astro.props

const variants = {
  primary: 'bg-primary text-primary-foreground hover:bg-primary/90',
  outline: 'border bg-background hover:bg-accent hover:text-accent-foreground'
}

const sizes = {
  sm: 'h-8 px-3 text-[13px]',
  md: 'h-11 px-4 text-sm sm:px-5'
}
---

<a
  class:list={[
    'inline-flex items-center justify-center gap-2 rounded-md font-medium whitespace-nowrap transition-[color,background-color,transform] duration-150 ease-out active:scale-[0.98]',
    variants[variant],
    sizes[size],
    className
  ]}
  {...rest}
>
  <slot />
</a>
